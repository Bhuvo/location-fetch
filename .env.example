# IPTrace Configuration Template
# Copy this file to .env and adjust variables as needed

# Secret key for sessions and CSRF (generate with secrets.token_hex(32))
SECRET_KEY=change-this-to-a-very-secure-random-secret-key

# Initial Admin Credentials (created on first startup if no admin exists)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=AdminSecurePass123!

# Geolocation API Providers
# IPinfo token (optional, leave blank for free tier)
IPINFO_API_TOKEN=

# ip-api pro key (optional, leave blank for free tier)
IP_API_KEY=

# MaxMind GeoIP web service (optional, leave blank to use free ipapi.co fallback)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

FALLBACK_GEO_PROVIDER=ip-api

# Proxy and Security Headers
# Set to True ONLY if running behind a trusted reverse proxy (e.g. Nginx, Caddy, Cloudflare)
USE_PROXY_HEADERS=False
# Comma-separated list of trusted proxy IP addresses
TRUSTED_PROXIES=127.0.0.1,::1

# Rate Limiting
RATELIMIT_ENABLED=True

# Data Retention Policy (records older than N days can be purged; 0 to disable)
DATA_RETENTION_DAYS=90

# Localhost Development Helper:
# If True and testing from 127.0.0.1 / localhost, will attempt to resolve
# the server's public IP so geolocation coordinates can be tested locally.
DEV_RESOLVE_SERVER_PUBLIC_IP=False

# Cookie security (set to True when deployed over HTTPS)
SESSION_COOKIE_SECURE=False
